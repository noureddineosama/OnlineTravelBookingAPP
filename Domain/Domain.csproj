<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Entity names are lowercase (DB-scaffolded). Suppress reserved-keyword warning. -->
    <NoWarn>CS8981</NoWarn>
  </PropertyGroup>

  <!-- [Index] and [Unicode] attributes are from EF Core — minimal reference needed -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
  </ItemGroup>

  <!-- Exclude the old scaffolded Models folder — entities now live in Entities/ -->
  <ItemGroup>
    <Compile Remove="Models\**" />
  </ItemGroup>

</Project>
