<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- AutoMapper 14.0.0 advisory (no fix available yet) -->
    <NoWarn>NU1903;CS8618;CS8601;CS8625;CS8600;CS8602;CS8603;CS8604</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- CQRS / Mediator -->
    <PackageReference Include="AutoMapper" Version="14.0.0" />
    <PackageReference Include="MediatR" Version="12.5.0" />
    <!-- Validation Pipeline -->
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.0.0" />
    <!-- Only for DbSet<T> abstraction in IApplicationDbContext -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Stripe.net" Version="52.1.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Domain\Domain.csproj" />
  </ItemGroup>
  <!-- Exclude old helpers â€” superseded by Clean Architecture structure -->
  <ItemGroup>
    <Compile Remove="Features\HotelImages\**" />
    <Compile Remove="Helpers\**" />
    <EmbeddedResource Remove="Features\HotelImages\**" />
    <None Remove="Features\HotelImages\**" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Features\Images\HotelImages\" />
    <Folder Include="Features\Images\RoomImages\" />
    <Folder Include="Features\Payments\Commands\HandleStripeWebhook\" />
  </ItemGroup>
</Project>