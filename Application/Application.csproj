<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- AutoMapper 14.0.0 advisory (no fix available yet) -->
    <NoWarn>NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- CQRS / Mediator -->
    <PackageReference Include="AutoMapper" Version="14.0.0" />
    <PackageReference Include="MediatR" Version="12.5.0" />

    <!-- Validation Pipeline -->
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.0.0" />

    <!-- Only for DbSet<T> abstraction in IApplicationDbContext -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Stripe.net" Version="52.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Domain\Domain.csproj" />
  </ItemGroup>

  <!-- Exclude old helpers — superseded by Clean Architecture structure -->
  <ItemGroup>
    <Compile Remove="Helpers\**" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Features\Payments\Commands\HandleStripeWebhook\" />
  </ItemGroup>

</Project>
