            "description": "List all tour bookings for a user, paginated."
          }
        },
        {
          "name": "Get User Tour Bookings – Filter by Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
