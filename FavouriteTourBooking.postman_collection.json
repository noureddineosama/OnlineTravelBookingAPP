            "url": { "raw": "{{baseUrl}}/api/tour-bookings", "host": ["{{baseUrl}}"], "path": ["api", "tour-bookings"] },
            "description": "Non-existent userId — NotFoundException → 404."
          }
        },
        {
          "name": "Get Tour Booking by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Response has full booking details', () => {",
                  "    const data = pm.response.json().data;",
                  "    pm.expect(data).to.have.property('bookingId');",
                  "    pm.expect(data).to.have.property('bookingNumber');",
                  "    pm.expect(data).to.have.property('tourTitle');",
                  "    pm.expect(data).to.have.property('scheduleStartDate');",
                  "    pm.expect(data).to.have.property('adultsCount');",
                  "    pm.expect(data).to.have.property('priceTierName');",
                  "    pm.expect(data).to.have.property('subtotal');",
                  "    pm.expect(data).to.have.property('totalPrice');",
                  "    pm.expect(data).to.have.property('currency');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
