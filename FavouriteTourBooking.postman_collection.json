            "    pm.expect(data).to.have.property('totalPages');",
            "    pm.expect(data.items).to.be.an('array');",
            "});",
            "pm.test('Items have UI-ready shape', () => {",
            "    const items = pm.response.json().data.items;",
            "    if (items.length > 0) {",
            "        pm.expect(items[0]).to.have.property('favoriteId');",
            "        pm.expect(items[0]).to.have.property('category');",
            "        pm.expect(items[0]).to.have.property('categoryLabel');",
            "        pm.expect(items[0]).to.have.property('itemId');",
