                  "    pm.expect(body.success).to.be.false;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 0,\n  \"tourId\": -1\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/favourite-tours", "host": ["{{baseUrl}}"], "path": ["api", "favourite-tours"] },
            "description": "Invalid IDs — FluentValidation should reject with 400."
