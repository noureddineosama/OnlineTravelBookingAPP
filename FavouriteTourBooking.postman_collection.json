  },
  "variable": [
    { "key": "baseUrl",    "value": "http://localhost:5183", "type": "string" },
    { "key": "userId",     "value": "4",                    "type": "string" },
    { "key": "tourId",     "value": "1",                    "type": "string" },
    { "key": "scheduleId", "value": "1",                    "type": "string" },
    { "key": "bookingId",  "value": "",                     "type": "string" }
  ],
  "item": [
    {
      "name": "🌟 Favourite Tours",
      "item": [
        {
          "name": "Add Tour to Favourites",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Success is true', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.be.true;",
                  "});",
                  "pm.test('Response has tour data', () => {",
                  "    const data = pm.response.json().data;",
                  "    pm.expect(data).to.have.property('favouriteId');",
                  "    pm.expect(data).to.have.property('tourId');",
                  "    pm.expect(data).to.have.property('title');",
                  "    pm.expect(data).to.have.property('addedAt');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"tourId\": {{tourId}}\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/favourite-tours", "host": ["{{baseUrl}}"], "path": ["api", "favourite-tours"] },
            "description": "Add a tour to a user's favourites.\n\n✅ Happy path: valid userId + active tourId\n❌ Test duplicate: run again → expect 400 'Already in favourites'\n❌ Test invalid: userId=0 → expect 400 validation error"
          }
        },
        {
          "name": "Add Tour to Favourites – Duplicate (expect 409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('Success is false', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.be.false;",
                  "    pm.expect(body.message).to.include('already');",
                  "    pm.expect(body.statusCode).to.equal(409);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"tourId\": {{tourId}}\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/favourite-tours", "host": ["{{baseUrl}}"], "path": ["api", "favourite-tours"] },
            "description": "Same payload as Add — must return 409 Conflict with 'already in your favourites'."
          }
        },
        {
          "name": "Add Tour to Favourites – Validation Error (expect 400)",
          "event": [
