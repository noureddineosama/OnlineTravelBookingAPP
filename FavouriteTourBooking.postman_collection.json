                  "    pm.expect(data).to.have.property('pageSize');",
                  "    pm.expect(data.items).to.be.an('array');",
                  "});",
                  "pm.test('Items have booking shape', () => {",
                  "    const items = pm.response.json().data.items;",
                  "    if (items.length > 0) {",
                  "        pm.expect(items[0]).to.have.property('bookingId');",
                  "        pm.expect(items[0]).to.have.property('bookingNumber');",
                  "        pm.expect(items[0]).to.have.property('status');",
                  "        pm.expect(items[0]).to.have.property('tourTitle');",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tour-bookings/user/{{userId}}?page=1&pageSize=10",
