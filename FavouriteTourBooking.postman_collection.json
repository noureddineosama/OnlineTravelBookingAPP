    {
      "name": "🗓️ Tour Bookings",
      "item": [
        {
          "name": "Create Tour Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Success is true', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.be.true;",
                  "});",
                  "pm.test('Booking has correct shape', () => {",
                  "    const data = pm.response.json().data;",
                  "    pm.expect(data).to.have.property('bookingId');",
                  "    pm.expect(data).to.have.property('bookingNumber');",
                  "    pm.expect(data.bookingNumber).to.match(/^TOUR-/);",
                  "    pm.expect(data).to.have.property('status');",
                  "    pm.expect(data.status).to.equal('Confirmed');",
                  "    pm.expect(data).to.have.property('totalPrice');",
                  "    pm.expect(data).to.have.property('paymentStatus');",
                  "    pm.expect(data.paymentStatus).to.equal('pending');",
                  "});",
                  "// Save bookingId for later requests",
                  "const bookingId = pm.response.json().data?.bookingId;",
                  "if (bookingId) { pm.collectionVariables.set('bookingId', bookingId.toString()); }",
                  "pm.test('bookingId saved to variable', () => {",
                  "    pm.expect(pm.collectionVariables.get('bookingId')).to.not.equal('');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tourScheduleId\": {{scheduleId}},\n  \"adultsCount\": 2,\n  \"childrenCount\": 1,\n  \"infantsCount\": 0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tour-bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tour-bookings"
              ]
            },
            "description": "Create a tour booking.\n\n✅ Happy path: valid userId, future scheduleId, adultsCount >= 1\n\nThe bookingId is auto-saved to the {{bookingId}} collection variable for subsequent requests."
          }
        },
