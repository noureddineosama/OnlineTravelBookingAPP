              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"tourScheduleId\": {{scheduleId}},\n  \"adultsCount\": 0,\n  \"childrenCount\": 1,\n  \"infantsCount\": 0\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/tour-bookings", "host": ["{{baseUrl}}"], "path": ["api", "tour-bookings"] },
            "description": "adultsCount=0 violates FluentValidation rule (>= 1 required)."
