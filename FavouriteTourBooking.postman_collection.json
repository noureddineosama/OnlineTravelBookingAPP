        {
          "name": "Create Tour Booking",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
            "pm.test('Success is true', () => { pm.expect(pm.response.json().success).to.be.true; });",
            "pm.test('Booking has correct shape', () => {",
            "    const data = pm.response.json().data;",
            "    pm.expect(data).to.have.property('bookingId');",
            "    pm.expect(data).to.have.property('bookingNumber');",
            "    pm.expect(data.bookingNumber).to.match(/^TOUR-/);",
            "    pm.expect(data.status).to.equal('confirmed');",
            "    pm.expect(data.paymentStatus).to.equal('pending');",
            "});",
            "const bookingId = pm.response.json().data?.bookingId;",
            "if (bookingId) { pm.collectionVariables.set('bookingId', bookingId.toString()); }"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
