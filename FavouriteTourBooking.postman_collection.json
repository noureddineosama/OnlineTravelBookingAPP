            "description": "Remove the tour from favourites."
          }
        },
        {
          "name": "Check Tour is Favourite (expect false)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
