              "path": ["api", "favourite-tours", "{{userId}}", "check", "{{tourId}}"]
            },
            "description": "After adding — should return data: true."
          }
        },
        {
          "name": "Get User Favourite Tours (paginated)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Paged response structure', () => {",
                  "    const data = pm.response.json().data;",
                  "    pm.expect(data).to.have.property('items');",
                  "    pm.expect(data).to.have.property('totalCount');",
                  "    pm.expect(data).to.have.property('page');",
                  "    pm.expect(data).to.have.property('pageSize');",
                  "    pm.expect(data).to.have.property('totalPages');",
                  "    pm.expect(data).to.have.property('hasNextPage');",
                  "    pm.expect(data).to.have.property('hasPreviousPage');",
                  "    pm.expect(data.items).to.be.an('array');",
                  "});",
                  "pm.test('Items have correct shape', () => {",
                  "    const items = pm.response.json().data.items;",
                  "    if (items.length > 0) {",
                  "        pm.expect(items[0]).to.have.property('favouriteId');",
                  "        pm.expect(items[0]).to.have.property('tourId');",
                  "        pm.expect(items[0]).to.have.property('title');",
                  "        pm.expect(items[0]).to.have.property('startingFromPrice');",
                  "        pm.expect(items[0]).to.have.property('addedAt');",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/favourite-tours/{{userId}}?page=1&pageSize=10",
